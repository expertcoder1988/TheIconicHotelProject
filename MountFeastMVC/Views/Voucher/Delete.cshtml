@model MountFeastMVC.Models.Voucher

@{
    ViewBag.Title = "Delete Voucher";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-body">
    <h2 class="callout callout-info" style="text-align:center; font-weight:bold"> Delete Voucher</h2>

    <div class="container">
        <h3>Are you sure you want to delete this?</h3>
        <div>
            <hr />
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.Code)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.Code)
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.DiscountAmount)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.DiscountAmount)
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.ExpiryDate)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.ExpiryDate)
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.Remarks)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.Remarks)
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.IsActive)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.IsActive)
                </dd>
            </dl>

            @using (Html.BeginForm("DeleteConfirmed", "Voucher", new { id = Model.VoucherId }, FormMethod.Post))
            {
                @Html.HiddenFor(model => model.VoucherId)
                <div class="form-group">
                    <input type="submit" id="btnDelete" name="btnDelete" value="Delete" class="btn btn-danger" /> |
                    @Html.ActionLink("Back to List", "Index")
                </div>
            }
        </div>
    </div>
</div>
<!-- Script for Voucher functionality -->
<script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
<script src="~/Scripts/EntityScript/Voucher.js"></script>