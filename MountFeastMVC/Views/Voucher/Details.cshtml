@model MountFeastMVC.Models.Voucher

@{
    ViewBag.Title = "Voucher Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-body" align="center">
    <h2 class="callout callout-info" style="text-align:center; font-weight:bold">Voucher Details</h2>
    <div class="container">
        <div class="row">
            <div class="col-md-3 col-xs-6">
                <div class="form-group">
                    <label for="Code">@Html.DisplayNameFor(model => model.Code)</label>
                    <p class="form-control-static">@Html.DisplayFor(model => model.Code)</p>
                </div>
            </div>
            <div class="col-md-3 col-xs-6">
                <div class="form-group">
                    <label for="DiscountAmount">@Html.DisplayNameFor(model => model.DiscountAmount)</label>
                    <p class="form-control-static">@Html.DisplayFor(model => model.DiscountAmount)</p>
                </div>
            </div>
            <div class="col-md-3 col-xs-6">
                <div class="form-group">
                    <label for="ExpiryDate">@Html.DisplayNameFor(model => model.ExpiryDate)</label>
                    <p class="form-control-static">@Html.DisplayFor(model => model.ExpiryDate)</p>
                </div>
            </div>
            <div class="col-md-3 col-xs-6">
                <div class="form-group">
                    <label for="Remarks">@Html.DisplayNameFor(model => model.Remarks)</label>
                    <p class="form-control-static">@Html.DisplayFor(model => model.Remarks)</p>
                </div>
            </div>
            <div class="col-md-3 col-xs-6">
                <div class="form-group">
                    <label for="IsActive">@Html.DisplayNameFor(model => model.IsActive)</label>
                    <p class="form-control-static">@Html.DisplayFor(model => model.IsActive)</p>
                </div>
            </div>
        </div>

        <div class="row" align="center">
            <div class="col-md-12 col-xs-12">
                <div class="form-group">
                    @Html.ActionLink("Edit", "Edit", new { id = Model.VoucherId }, new { @class = "btn btn-primary" }) |
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Script for Voucher functionality -->
<script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
<script src="~/Scripts/EntityScript/Voucher.js"></script>
