@{
    ViewBag.Title = "Published Posts";
}
<div class="row">
    <div class="col-md-12">
        <h5 class="d-inline align-middle">Published Posts</h5>
        <a href="@Url.Action("Manage", "Post", new { Area = "Admin" })" class="btn btn-primary btn-sm pull-right">New Post</a>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <table id="table" cellspacing="0" width="100%" class="table table-hover table-striped table-bordered dt-responsive"></table>
    </div>
</div>
@section style {
    @Styles.Render("~/Content/dataTables")
}
@section scripts {
    @Scripts.Render("~/bundles/datatables")
    <script type="text/javascript">
        var postStatus = 2;
    </script>
    <script src="~/Scripts/Admin/post.list.js"></script>
}