
@{
    ViewBag.Title = "Cancellation Policies";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-body">
    <h5 class="callout callout-info">Cancellation Policies</h5>
    <input type="hidden" id="AvoidReload" value="false" />
    <input type="hidden" id="Id" value="0" />
    <div class="container">
        <div class="row">
            <div class="form-group">
                <label for="Properties">Properties</label>
                <select class="form-control" style="height:34px;width:100%"
                        id="Properties" name="Properties">
                    <option selected="selected" value="0">Please select</option>
                </select>
            </div>

        </div>

        <div class="row">
            <div class="col-md-8 col-xs-12">
                <table class="table" id="Policies">
                    <tr>
                        <th>Policy ID</th>
                        <th>Policy Name</th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <input type="button" ID="doaddnew" name="doaddnew" class="btn btn-info" value="Create Customized Policy" />
        <input type="button" ID="Non-Refundable" name="Non-Refundable" class="btn btn-info" value="Create Non-Refundable Policy" />
    </div>
</div>

    <!-- Description Modal -->
    <div class="modal fade" id="basicInfoModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">New Cancellation Policy</h5>
                </div>
                <div class="modal-body">
                    <form id="Property">
                        <div class="row">
                            <div class="col-md-12 col-xs-12">
                                <div class="form-group">
                                    <label for="propertyID">Policy Name</label>
                                    <input type="text" id="PolicyName" maxlength="50" class="form-control" name="PolicyName" />
                                </div>
                                <div class="form-group">
                                    <h4>Cancellation Preferences</h4>
                                    <label for="propertyID">
                                        Is there a period when the guest can cancel free of charge?
                                    </label>
                                    <div class="icheck-primary d-inline">
                                        <input type="radio" checked id="radioPrimary1" name="r1" value="1">
                                        <label for="radioPrimary2">
                                            Yes
                                        </label>
                                    </div>
                                    <div class="icheck-primary d-inline">
                                        <input type="radio" id="radioPrimary2" name="r1" vale="0">
                                        <label for="radioPrimary2">
                                            No
                                        </label>
                                    </div>
                                </div>
                                <hr />
                                <h4>Specify Conditions</h4>
                                <div id="long" class="form-group">
                                    <label>How long before arrival can the guest cancel free of charge?</label>
                                    <select id="interval" class="form-control">
                                        <option value="-1">Please select...</option>
                                        <option value="1">until 6:00PM on the day of arrival</option>
                                        <option value="2">until 2:00PM on the day of arrival</option>
                                        <option value="3">until 1 day before arrival</option>
                                        <option value="4">until 2 days before arrival</option>
                                        <option value="5">until 3 days before arrival</option>
                                        <option value="6">until 5 days before arrival</option>
                                        <option value="7">until 7 days before arrival</option>
                                        <option value="8">until 14 days before arrival</option>
                                        <option value="9">until 21 days before arrival</option>
                                        <option value="10">until 28 days before arrival</option>
                                        <option value="11">until 30 days before arrival</option>
                                        <option value="12">until 42 days before arrival</option>
                                        <option value="13">until 60 days before arrival</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>How much is the guest charged for cancellation</label>
                                    <select id="cancellation" class="form-control">
                                        <option value="-1">Please select...</option>
                                        <option value="1">the cost of the first night</option>
                                        <option value="2">50% of the total price</option>
                                        <option value="3">100% of the total price</option>
                                    </select>
                                </div>

                                <div id="noshow" class="form-group">
                                    <label>How much is the guest charged for a no-show?</label>
                                    <select id="no-show" class="form-control">
                                        <option value="1">Same as the cancellation fee</option>
                                        <option value="2">100% of the total price</option>
                                    </select>
                                </div>
                                <div id="beforearrival" class="form-group">
                                    <h4>Prepayment</h4>
                                    <label for="propertyID">Do you want to charge guests before they arrive?</label>
                                    <div class="icheck-primary d-inline">
                                        <input type="radio" checked id="radioPrimary3" name="r2" value="0">
                                        <label for="radioPrimary3">
                                            No
                                        </label>
                                    </div>
                                    <div class="icheck-primary d-inline">
                                        <input type="radio" id="radioPrimary4" name="r2" value="1">
                                        <label for="radioPrimary4">
                                            Yes
                                        </label>
                                    </div>
                                </div>
                                <div id="collectprepayment">
                                    <div class="form-group">
                                        <label>When do you want to collect prepayment?</label>
                                        <div class="icheck-primary d-inline">
                                            <input type="radio" checked id="radioPrimary5" name="r3" value="1">
                                            <label for="radioPrimary5">
                                                After free cancellation ends
                                            </label>
                                        </div>
                                        <div class="icheck-primary d-inline">
                                            <input type="radio" id="radioPrimary6" name="r3" value="0">
                                            <label for="radioPrimary2">
                                                Before free cancellation ends
                                            </label>
                                        </div>
                                    </div>
                                    <div id="receiveprepaymen" class="form-group">
                                        <label>How will you receive the prepayment?</label>
                                        <select id="prepayment_options" class="form-control">
                                            <option value="-1">Select an option</option>
                                            <option value="1">Bank transfer</option>
                                            <option value="2">Credit card</option>
                                            <option value="3">Paypal</option>
                                            <option value="4">Other</option>
                                        </select>
                                    </div>
                                    <div id="refundtake" class="form-group">
                                        <label><span>In the case of cancellation, how long will a refund take? </span></label>
                                        <select id="prepayment_refund" class="form-control">
                                            <option value="-1">Select an option</option>
                                            <option value="1">Within 7 days</option>
                                            <option value="2">Within 14 days</option>
                                            <option value="3">Within 30 days</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" id="closeBasic" class="btn btn-secondary">Close</button>
                    <input type="button" id="UpdateBasicInfo" class="btn btn-primary" value="Save Policy" />
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="NonRefundableModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Non-Refundable Policy</h5>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12 col-xs-12">
                            <div class="form-group">
                                <h4>Non-Refundable</h4>
                                <p>When you set a non-refundable policy, the guest must pay 100% of the price when they make the booking. If they cancel their reservation, you do not have to give a refund.</p>
                                <hr />
                                <h4>Policy Summary</h4>
                                <p>The guest will be charged the total price if they cancel.</p>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="closeNonRef" class="btn btn-secondary">Close</button>
                    <input type="button" class="btn btn-primary" id="NonRef" value="Save Policy" />
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
    <script src="~/Scripts/EntityScript/Cancellation.js"></script>
