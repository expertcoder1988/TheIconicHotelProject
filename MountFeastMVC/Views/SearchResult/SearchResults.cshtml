<div class="properties-section property-big py-5 mt-3">
    <!-- Room Search Results -->
    <div class="container mt-5">
        <!-- property start -->
        @if (results.Count == 0)
        {
            <p>No room available. Please try another dates.</p>
        }
        else
        {

            <!-- property start -->
            foreach (var item in results)
            {
                //HotelDBEntities HDE = new HotelDBEntities();

                //var rp = (from a in HDE.RoomPictures
                //          where (a.RoomCode == item.RoomCateCode)
                //          select new
                //          {
                //              ImageName = a.Picture
                //          }).ToList();

                if (item.NoOfRooms > 0)
                {
                    string[] features = null;
                    using (Html.BeginForm("ReservationPost2", "SearchResult", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="property property-hp row g-0 fp2 clearfix wow fadeInUp delay-03s ">
                            <div class="col-lg-4 col-md-4 col-sm-12">
                                <!-- Property img -->
                                <div class="property-img">
                                    <div class="property-tag button alt featured">Hurry! @item.NoOfRooms <span>Rooms Left</span></div>
                                    <input type="hidden" name="NoOfRoomsLeft" id="NoOfRoomsLeft_@item.Id" value="@item.NoOfRooms" />
                                    <div class="property-tag button sale">Featured</div>

                                    <img src="../uploads/@item.imgURL"
                                         alt="fp-list"
                                         class="img-fluid w-100" />
                                    <div class="property-overlay">

                                        <a href="@item.VideoLink" class="overlay-link property-video" target="_blank" title="@item.RoomCategory">
                                            <i class="fa fa-video-camera"></i>
                                        </a>
                                        <div class="property-magnify-gallery">
                                            <a href="../uploads/@item.imgURL" class="overlay-link">
                                                <i class="fa fa-expand"></i>
                                            </a>

                                            @foreach (var itm in Img)
                                            {
                                                if (itm.Category == item.RoomCateCode)
                                                {
                                                    <a href="../uploads/@itm.ImageName" class="hidden"></a>
                                                }
                                            }


                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-8 col-md-8 col-sm-12 property-content">
                                <div class="info">
                                    <div class="container">
                                        <div class="row">
                                            <div id="dvPolicy" class="col-sm">
                                                <!-- title -->
                                                <h1 class="title">
                                                    <a href="#" id="RoomCate_@item.RoomCateCode">@item.RoomCategory</a>
                                                    <input type="hidden" data-value="@item.Id" id="hdRoomCate_@item.Id" value="@item.RoomCateCode" />
                                                </h1>
                                                <!-- Property address -->
                                                <h6 class="property-address" style="color:black">
                                                    Policy: <u><a role="button" name="policy" id="policy_@item.CancellationPolicy">@item.Name</a></u>
                                                </h6>
                                            </div>
                                            <div class="col-sm">
                                                <div class="facilities-list clearfix">
                                                    <div>
                                                        Add Rooms:
                                                        <input type="button" class="btn-sm btn-light rounded-button" style="background-color: ButtonFace; box-shadow: none; border: none;" ID="CalculateMinus_@item.Id" name="CalculateMinus" data-value="@item.Id" value="-" />
                                                        <input type="text" value="1" class="text-center" style="width:30px" name="txtQuatntity" ID="txtQuatntity_@item.Id" />
                                                        <input type="button" class="btn-sm btn-light rounded-button" style="background-color: ButtonFace; box-shadow: none; border: none;" data-value="@item.Id" ID="CalculatePlus_@item.Id" name="CalculatePlus" value="+" />
                                                    </div>
                                                    <div>
                                                        <input type="checkbox" style="display:none" name="SelectRoom" id="SelectRoom_@item.Id" value="@item.Id" />

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm"
                                                 style="font-weight: bold; font-size: 18px; margin: 2px, 2px">
                                                @if (item.TotalAmount == item.discountedprice || item.discountedprice == null)
                                                {
                                                    <span>Rs. <span id="spNormalPrice_@item.Id">@item.TotalAmount</span> / @NoOfDays Nights</span>
                                                }
                                                else
                                                {
                                                    <span style="text-decoration:line-through">Rs. <span id="spNormalPrice_@item.Id">@item.TotalAmount</span>  / @NoOfDays @(@NoOfDays == 1 ? "Night" : "Nights")</span><br />
                                                    <span style="color: #a85307">Rs. <span id="spDiscountedPRice_@item.Id">@item.discountedprice</span>  / @NoOfDays @(@NoOfDays == 1 ? "Night" : "Nights")</span>
                                                }

                                                <input type="hidden" id="hdNormalPrice_@item.Id" value="@item.TotalAmount" />
                                                <input type="hidden" id="hdDiscountedPrice_@item.Id" value="@item.discountedprice" />
                                                <input type="hidden" name="RatePlanID" id="RatePlanID_@item.Id" value="@item.rateplanId" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Facilities List -->
                                    <ul class="facilities-list clearfix">
                                        @{
                                            if (item.Features != null)
                                            {
                                                features = item.Features.Split(',');

                                                foreach (var itm in features)
                                                {
                                                    if (itm != "")
                                                    {
                                                        <li style="font-size:10px">
                                                            <i class="fa fa-check"></i>
                                                            <span>@itm.Replace('_', ' ')</span>
                                                        </li>
                                                    }
                                                }
                                            }
                                        }
                                    </ul>
                                </div>
                                <div class="property-footer row">
                                    <span class="left col-6">
                                        <a href="#"><i class="fa fa-user"><span style=" font-family: Arial, sans-serif !important;"> @item.AdultAllowed Adult</span> <span style=" font-family: Arial, sans-serif !important;">, @item.NoOfChildAllowed Child</span></i></a>
                                    </span>
                               

                                    <span class="right col-6">
                                        <!-- Align buttons to the right -->
                                        <input type="submit"
                                               class="btn booking"
                                               data-value="@item.Id"
                                               name="ShowDetails"
                                               id="ShowDetails_@item.Id"
                                               value="Reserve This" style="color: white; background-color: #a85307; text-align: center; padding: .375rem .75rem; font-size: 1rem; border-radius: .25rem; " />

                                    </span>
                                </div>

                            </div>
                        </div>
                        <input type="hidden" id="hdTotalRooms" name="hdTotalRooms" value="1" />
                        <input type="hidden" id="hdTotalAmount" name="hdTotalAmount" value="@item.TotalAmount" />
                        <input type="hidden" name="CheckIn" value="@_CheckIn" />
                        <input type="hidden" name="CheckOut" value="@_CheckOut" />
                        <input type="hidden" name="RoomCatCode" id="RoomCatCode" />
                        <input type="hidden" name="Adults" value="@_adults" />
                        <input type="hidden" name="Children" value="@_children" />
                        <input type="hidden" name="NoOfRooms" value="@_NoOfRooms" />
                        <input type="hidden" name="RoomRate" value="@roomPrice" />
                        <input type="hidden" name="RoomCate" value="@item.RoomCateCode" />
                        <input type="hidden" name="RoomCateRoomNums" id="RoomCateRoomNums" />
                        <input type="hidden" name="RatePlanIDs" value="@item.rateplanId" />
                        <input type="hidden" name="RoomRates" value="@item.discountedprice" />
                    }
                }

            }
        }


    </div>
</div>




