@using MountFeastMVC.Models;

@{
    ViewBag.Title = "Iconic Hotel  at Naran | Available Rooms";
    ViewBag.keywords = "Hotel at Naran";

    ViewBag.Description = "Iconic Hotel  at Naran is the best place to stay. Our hotel in Naran Pakistan offers luxurious rooms, equipped with all the amenities. Book Online.";


    List<MountFeastMVC.Models.PropertySearch> results = new List<MountFeastMVC.Models.PropertySearch>();

    string _CheckIn = "";// DateTime.Now;
    string _CheckOut = ""; // DateTime.Now;

    int checkRooms = 0;

    int? _adults = 0;
    int? _children = 0;
    int? _NoOfRooms = 0;
    int? roomPrice = 0;
    int? _TotalPax = 0;
    string Params = (string)Session["params"];
    string[] p = Params.Split('&');

    _CheckIn = Convert.ToString(p[0]);
    _CheckOut = Convert.ToString(p[1]);
    _adults = Convert.ToInt32(p[2]);
    _children = Convert.ToInt32(p[3]);
    _NoOfRooms = Convert.ToInt32(p[4]);
    _TotalPax = _adults + _children;

    List<MountFeastMVC.Controllers.RoomImages> Img = new List<MountFeastMVC.Controllers.RoomImages>();
    int NoOfDays = ViewBag.NoOfDays;

    if (TempData["Images"] != null)
    {
        Img = (List<MountFeastMVC.Controllers.RoomImages>)TempData["Images"];
    }

    if (_TotalPax == 0)
    {
        _TotalPax = 1;
    }

    if (Session["results"] != null)
    {
        results = (List<MountFeastMVC.Models.PropertySearch>
            )Session["results"];
    }
}

