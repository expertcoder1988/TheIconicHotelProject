<script type="text/javascript">
    var $j = jQuery.noConflict();

    $j(function () {

        $j("input[name='RemoveRooms']").hide();

        $j("input[name='CalculateMinus']").on('click', function () {
            var id = $j(this).data("value");
            var quantityInput = $j('#txtQuatntity_' + id);
            var quantity = parseInt(quantityInput.val());

            if (quantity > 1) {
                quantity -= 1;
                quantityInput.val(quantity);

                updatePrices(id, quantity);
            }

            Calculate(id);
        });

        $j("input[name='CalculatePlus']").on('click', function () {
            var id = $j(this).data("value");
            var quantityInput = $j('#txtQuatntity_' + id);
            var quantity = parseInt(quantityInput.val());
            var roomsLeft = parseInt($j('#NoOfRoomsLeft_' + id).val());

            if (quantity < roomsLeft) {
                quantity += 1;
                quantityInput.val(quantity);

                updatePrices(id, quantity);
            }

            Calculate(id);
        });

        $j("input[name='ShowDetails']").on('click', function () {
            var id = $j(this).data("value");
            $j("#SelectRoom_" + id).prop("checked", true);
            Calculate(id);
        });

        $j("input[name='RemoveRooms']").on('click', function () {
            var id = $j(this).data("value");
            $j("#SelectRoom_" + id).prop("checked", false);
            $j(this).hide();
            Calculate(id);
        });

        function updatePrices(id, quantity) {
            var normalPrice = parseInt($j('#hdNormalPrice_' + id).val());
            var discountedPrice = parseInt($j('#hdDiscountedPrice_' + id).val());

            $j("#spNormalPrice_" + id).html(normalPrice * quantity);
            $j("#spDiscountedPRice_" + id).html(discountedPrice * quantity);
        }

        function Calculate(_Id) {
            var TotalRooms = 0;
            var GrandTotal = 0;
            var RoomCate = "";
            var _RoomCateRoomNums = '';
            var _RatePlanID = '';
            var _RoomRates = '';
            var _RoomRatesN = '';

            var _roomCate = $j('#hdRoomCate_' + _Id).val();
            var roomCateRoomNums = $j('#txtQuatntity_' + _Id).val();

            _RoomRates += ',' + $j('#hdDiscountedPrice_' + _Id).val();
            _RoomRatesN += ',' + $j('#hdNormalPrice_' + _Id).val();

            var _ratePlanID = $j('#RatePlanID_' + _Id).val();
            _RatePlanID += ',' + _ratePlanID;

            TotalRooms += parseInt(roomCateRoomNums);
            var discountedHtml = $j("#spDiscountedPRice_" + _Id).html();
            GrandTotal += parseInt(discountedHtml) || parseInt($j('#hdNormalPrice_' + _Id).val()) * TotalRooms;

            RoomCate += "," + _roomCate;
            _RoomCateRoomNums += "," + roomCateRoomNums;

            $j('#RatePlanIDs').val(_RatePlanID);
            $j('#hdTotalRooms').val(TotalRooms);
            $j('#hdTotalAmount').val(GrandTotal);
            $j('#_TotalRooms, #_TotalRooms1').html(TotalRooms);
            $j('#_TotalAmount, #_TotalAmount1').html(GrandTotal);
            $j('#RoomCatCode').val(RoomCate);
            $j('#RoomCateRoomNums').val(_RoomCateRoomNums);
            $j('#RoomRates').val(_RoomRates);
        }

        // Modal close/open
        $j('#OpenModal').click(() => {
            $('#myModal').modal('show');
            $("#sticky").hide();
        });

        $j('#closemodal').click(() => {
            $('#myModal').modal('hide');
            $("#sticky").show();
        });

        $j('#closepicmodal').click(() => {
            $('#carouselModal').modal('hide');
        });

        $j('#closepolicymodal').click(() => {
            $('#policyModal').hide();
        });

        // Fetch policy details
        $j("#dvPolicy a").click(function () {
            var _id = $j(this).attr('id').split('_')[1];

            $.ajax({
                url: '/SearchResult/RoomPolicy',
                type: 'GET',
                dataType: 'json',
                data: { CancellationPolicy: _id },
                success: function (data) {
                    if (data.length > 0) {
                        const item = data[0];

                        $("#policyName").text(item.RatePlanName);
                        $("#Breakfst").text(item.Breakfst ? "Included" : "Not Included");
                        $("#CancellationPolicy").text(item.CancellationPolicy);

                        $("#ChargedForNoShow").text(
                            item.ChargedForNoShow === 1 ? "Same as the cancellation fee" : "100% of the total price"
                        );

                        let cancelText = "No Free Cancellation";
                        switch (item.FreeCancelBefore) {
                            case 1: cancelText = "The cost of the first night"; break;
                            case 2: cancelText = "50% of the total price"; break;
                            case 3: cancelText = "100% of the total price"; break;
                        }
                        $("#FreeCancelBefore").text(cancelText);

                        let howLong = {
                            1: "until 6:00PM on the day of arrival",
                            2: "until 2:00PM on the day of arrival",
                            3: "until 1 day before arrival",
                            4: "until 2 days before arrival",
                            5: "until 3 days before arrival",
                            6: "until 5 days before arrival",
                            7: "until 7 days before arrival",
                            8: "until 14 days before arrival",
                            9: "until 21 days before arrival",
                            10: "until 28 days before arrival",
                            11: "until 30 days before arrival",
                            12: "until 42 days before arrival",
                            13: "until 60 days before arrival"
                        };

                        $("#GuestChargedForCancellation").text(howLong[item.HowlongFreeOfCharge] || "N/A");

                        $j("#policyModal").show();
                    }
                },
                error: function (err) {
                    alert(err.status + " : " + err.statusText);
                }
            });
        });
    });
</script>


