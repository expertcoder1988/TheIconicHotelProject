
@{
    ViewBag.Title = "BlockRoom";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-body">
    <h5 class="callout callout-info">Block Room/s</h5>
    <input type="hidden" id="AvoidReload" value="false" />
    <input type="hidden" id="RateSlabId" value="-1" />
    <div class="container">
        <div class="row">
            <div class="form-group">
                <div class="col-md-3">
                    <label id="lblProduct">
                        Please Select Property
                    </label>
                    <select ID="Properties" class="form-control">
                    </select>
                </div>
                <div class="col-md-3">
                    <label id="lblProduct">
                        Please Select Category
                    </label>
                    <select ID="rooms" class="form-control">
                        <option selected>Please Select Room Category</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label id="lblProduct">
                        Total Rooms Available
                    </label>
                    <input type='number' disabled="disabled" ID='TotalRooms' class='form-control' />
                </div>
                <div class="col-md-3">
                    <label id="lblProduct">
                        Room Number
                    </label>
                    <select id="RoomNum" name="RoomNum" class="form-control">
                        @*<option value="">Select Room</option>*@
                    </select>
                </div>

            </div>

            <br />
            <br />
            <div class="form-group">
                <div class="col-md-6">
                    <label id="lblProduct">
                        Start Date
                    </label>
                    <input type='date' ID='StartDate' class='form-control' />
                </div>
                <div class="col-md-6">
                    <label id="lblProduct">
                        End Date
                    </label>
                    <input type='date' ID='EndDate' class='form-control' />
                </div>
            </div>

            <div class="form-group">
                <label id="lblProduct"> </label>
                <div class="col-md-12" style="padding-top: 15px; padding-bottom: 10px">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" />
                </div>

            </div>
            <br />
            <div class="row">
                <div class="col-md-12 col-xs-12">
                    <table class="table" id="RatePlan">
                        <tr>
                            <th style=display:none>Room Caterogy ID</th>
                            <th>Room Category</th>
                            <th>Room Num</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th></th>
                            <th></th>
                        </tr>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
<script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
<script src="~/Scripts/EntityScript/BlockRoom.js"></script>

