</div>

<!-- Address Modal -->
<div class="modal fade" id="AddressModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Location</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 col-xs-6">
                        <div class="form-group">
                            <label for="propertyID">Property ID</label>
                            <input type="text" disabled id="propertyID1" class="form-control" name="propertyID" />
                        </div>
                        <div class="form-group">
                            <label for="Country">Country</label>
                            <select id="Country" name="Country" class="form-control">
                                <option value='0'>Select Your Country</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="City">City</label>
                            <input type="text" class="form-control" id="City" name="City">
                        </div>
                        <div class="form-group">
                            <label for="Latitude">Latitude </label>
                            <input type="text" class="form-control" id="Latitude" name="Latitude">
                        </div>
                    </div>
                    <div class="col-md-6 col-xs-6">
                        <div class="form-group">
                            <label for="Address">Address</label>
                            <input type="text" id="Address" class="form-control" name="Address" />
                        </div>

                        <div class="form-group">
                            <label for="State">Province / State</label>
                            <input type="text" id="State" class="form-control" name="State" />
                        </div>
                        <div class="form-group">
                            <label for="PostalCode">Postal Code</label>
                            <input type="text" class="form-control" id="PostalCode" name="PostalCode" />
                        </div>

                        <div class="form-group">
                            <label for="Longitude">Longitude </label>
                            <input type="text" class="form-control" id="Longitude" name="Longitude" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="closeAddress" class="btn btn-secondary">Close</button>
                <input type="button" class="btn btn-primary" id="UpdateAddress" value="Save changes" />
            </div>
        </div>
    </div>
</div>

