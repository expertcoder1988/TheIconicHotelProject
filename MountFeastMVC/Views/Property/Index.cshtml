
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}



<div class="box-body">
    <h5 class="callout callout-info">Property List</h5>
    <input type="hidden" id="AvoidReload" value="false" />

    <div class="row">
        <div class="col-md-8 col-xs-12">
            <table class="table" id="properties">
                <tr>
                    <th>Property ID</th>
                    <th>Property Name</th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <input type="button" ID="doaddnew" name="doaddnew" class="btn btn-info" value="Add New Property" />
</div>

<!-- Modal -->
