                            </div>
                            <div class="form-group">
                                <label for="propertyID">Phone</label>
                                <input type="text" class="form-control" id="Phone" name="Phone">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Email</label>
                                <input type="email" class="form-control" id="Email" name="Email">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Contact Person</label>
                                <input type="text" class="form-control" id="ContactPerson" name="ContactPerson">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Currency Symbol</label>
                                <input type="text" class="form-control" id="CurrencySymbol" name="CurrencySymbol">
                            </div>
                            <div class="form-group">
                              
                            </div>
                        </div>
                    </div>
