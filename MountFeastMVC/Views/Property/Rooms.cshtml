
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-body">
    <h5 class="callout callout-info">Rooms</h5>
    <input type="hidden" id="AvoidReload" value="false" />
    <input type="hidden" id="RoomCode1" value="false" />
    <div class="container">
        <div class="row">
            <div class="form-group">
                <label for="Properties">Properties</label>
                <select class="form-control" style="height:34px;width:100%"
                        id="Properties" name="Properties">
                    <option selected="selected" value="0">Please select</option>
                </select>
            </div>

        </div>

        <div class="row">
            <div class="col-md-8 col-xs-12">
                <table class="table" id="rooms">
                    <tr>
                        <th>Room ID</th>
                        <th>Room Category</th>
                        <th></th>
                        <th></th>
                    </tr>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <input type="button" ID="doaddnew" name="doaddnew" class="btn btn-info" value="Add New Room" />
    </div>
</div>

<!-- Description Modal -->
<div class="modal fade" id="basicInfoModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered  modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Property Description</h5>
            </div>
            <div class="modal-body">
                <form id="Property">
                    <div class="row">
                        <div class="col-md-4 col-xs-4">
                            <div class="form-group">
                                <label for="propertyID">Room ID</label>
                                <input type="text" disabled id="RoomCode" class="form-control" name="RoomCode" />
                            </div>
                            <div class="form-group">
                                <label for="propertyID">No Of Rooms</label>
                                <input type="number" class="form-control" id="NoOfRooms" name="NoOfRooms">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Maximum Guests</label>
                                <input type="number" class="form-control" id="Capacity" name="Capacity">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Child Age</label>
                                <select class="form-control" style="height:34px;width:100%"
                                        id="ChildAge" name="ChildAge">
                                    <option selected="selected" value="0">Please select</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                    <option value="6">6</option>
                                    <option value="7">7</option>
                                    <option value="8">8</option>
                                    <option value="9">9</option>
                                    <option value="10">10</option>
                                    <option value="11">11</option>
                                    <option value="12">12</option>
                                    <option value="13">13</option>
                                    <option value="14">14</option>
                                    <option value="15">15</option>
                                    <option value="16">16</option>
                                    <option value="17">17</option>
                                    <option value="18">18</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Short Code</label>
                                <input type="text" maxlength="3" class="form-control" id="ShortCode" name="ShortCode">
                            </div>
                            <div style="display:none" class="form-group">
                                <label for="propertyID">Minimum Price</label>
                                <input type="number" class="form-control" value="0" id="MinimumPrice" name="MinimumPrice">
                            </div>
                        </div>

                        <div class="col-md-4 col-xs-4">
                            <div class="form-group">
                                <label for="propertyType">Room Category</label>
                                <select class="form-control" style="height:34px;width:100%"
                                        id="RoomCategory" name="RoomCategory">
                                    <option selected="selected" value="0">Please select</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Check In</label>
                                <select class="form-control" style="height:34px;width:100%"
                                        id="CheckIn" name="CheckIn">
                                    <option selected="selected" value="0">Please select</option>
                                    <option value="00:00">00:00</option>
                                    <option value="01:00">01:00</option>
                                    <option value="02:00">02:00</option>
                                    <option value="03:00">03:00</option>
                                    <option value="04:00">04:00</option>
                                    <option value="05:00">05:00</option>
                                    <option value="06:00">06:00</option>
                                    <option value="07:00">07:00</option>
                                    <option value="08:00">08:00</option>
                                    <option value="09:00">09:00</option>
                                    <option value="10:00">10:00</option>
                                    <option value="11:00">11:00</option>
                                    <option value="12:00">12:00</option>
                                    <option value="13:00">13:00</option>
                                    <option value="14:00">14:00</option>
                                    <option value="15:00">15:00</option>
                                    <option value="16:00">16:00</option>
                                    <option value="17:00">17:00</option>
                                    <option value="18:00">18:00</option>
                                    <option value="19:00">19:00</option>
                                    <option value="20:00">20:00</option>
                                    <option value="21:00">21:00</option>
                                    <option value="22:00">22:00</option>
                                    <option value="23:00">23:00</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Maximum Adults</label>
                                <input type="number" class="form-control" id="Adult" name="Adult">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Minimum Stay</label>
                                <input type="number" class="form-control" id="MinimumStay" name="MinimumStay">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Room Size (Square Meters)</label>
                                <input type="number" class="form-control" id="Size" name="Size">
                            </div>
                        </div>

                        <div class="col-md-4 col-xs-4">
                            <div class="form-group">
                                <label for="propertyID">Room Description</label>
                                <input type="text" id="RoomDescription" maxlength="100" class="form-control" name="RoomDescription" />
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Check Out</label>
                                <select class="form-control" style="height:34px;width:100%"
                                        id="CheckOut" name="CheckOut">
                                    <option selected="selected" value="0">Please select</option>
                                    <option value="00:00">00:00</option>
                                    <option value="01:00">01:00</option>
                                    <option value="02:00">02:00</option>
                                    <option value="03:00">03:00</option>
                                    <option value="04:00">04:00</option>
                                    <option value="05:00">05:00</option>
                                    <option value="06:00">06:00</option>
                                    <option value="07:00">07:00</option>
                                    <option value="08:00">08:00</option>
                                    <option value="09:00">09:00</option>
                                    <option value="10:00">10:00</option>
                                    <option value="11:00">11:00</option>
                                    <option value="12:00">12:00</option>
                                    <option value="13:00">13:00</option>
                                    <option value="14:00">14:00</option>
                                    <option value="15:00">15:00</option>
                                    <option value="16:00">16:00</option>
                                    <option value="17:00">17:00</option>
                                    <option value="18:00">18:00</option>
                                    <option value="19:00">19:00</option>
                                    <option value="20:00">20:00</option>
                                    <option value="21:00">21:00</option>
                                    <option value="22:00">22:00</option>
                                    <option value="23:00">23:00</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Maximum Children</label>
                                <input type="number" class="form-control" id="NoOfChild" name="NoOfChild">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Maximum Stay</label>
                                <input type="number" class="form-control" id="MaximumStay" name="MaximumStay">
                            </div>
                            <div class="form-group">
                                <label for="propertyID">Bed Size</label>
                                <select class="form-control" style="height:34px;width:100%"
                                        id="BedType" name="BedType">
                                    <option selected="selected" value="0">Please select</option>
                                    <option value="Single">Single</option>
                                    <option value="Double">Double</option>
                                    <option value="Queen">Queen</option>
                                    <option value="King">King</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="closeBasic" class="btn btn-secondary">Close</button>
                <input type="button" id="UpdateBasicInfo" class="btn btn-primary" value="Save changes" />
            </div>
        </div>
    </div>

</div>

<!-- Room Numbers Modal -->
<div class="modal fade" id="RoomNumModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Assign Room Numbers</h5>
            </div>
            <div class="modal-body">
                <form method='post' action='' enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-12 col-xs-12">
                            <table class="table" id="roomNumbers">
                                <tr>
                                    <th>Room Number</th>
                                    <th>Floor</th>
                                    <th></th>
                                </tr>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" id="closeRoomNum" class="btn btn-secondary">Close</button>
                <input type="button" id="SaveRoomNum" value="Save Room Numbers" class="btn btn-primary">


                @*<input type="button" class="btn btn-primary" id="SaveRoomNum" value="Save Room Numbers" />*@
            </div>
        </div>
    </div>
</div>
