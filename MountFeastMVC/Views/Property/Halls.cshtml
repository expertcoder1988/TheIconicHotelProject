
@{
    ViewBag.Title = "Halls";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-header with-border">
    <h3 class="callout callout-info" style="text-align: center; font-weight: bold; font-size: 20px">Halls</h3>
</div>

<input type="hidden" id="AvoidReload" value="false" />
<input type="hidden" id="HallId" value="0" />
<input type="hidden" id="filename" value="" />
<div class="box-body">
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-6">
                    <label id="lblProduct">
                        Please Select Property
                    </label>
                    <select ID="ddlProperty" class="form-control">
                    </select>
                </div>
                <div class="col-md-6">
                    <label id="HallName">
                        Hall Name
                    </label>
                    <input type="text" id="HallName" maxlength="50" name="HallName" class="form-control" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-6">
                    <label id="lblProduct">
                        Hall Short Code
                    </label>
                    <input type="text" class="form-control" id="ShortCode" name="ShortCode" maxlength="3" />
                </div>
                <div class="col-md-6">
                    <label id="percent">
                        Covered Area(sq m)
                    </label>
                    <br />
                    <input type="number" id="CoveredArea" class="form-control" name="CoveredArea" maxlength="99999" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-6">
                    <label id="lblProduct">
                        Capacity
                    </label>
                    <input type="number" class="form-control" id="Capacity" name="Capacity" max="9999" />
                </div>
                <div class="col-md-6">
                    <br />
                    <input type="file" class="form-control" id="propertyPic"  />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-6">
                    <br />
                    <input type="button" class="btn btn-primary" id="Save" value="Save" />
                </div>
                <div class="col-md-6">
                    
                </div>
            </div>
        </div>
    </div>
</div>

<div class="box-body">
    <div class="row">
        <div class="col-md-12 col-xs-12">
            <table class="table" id="Halls">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Hall Name</th>
                        <th>Short Code</th>
                        <th>Covered Area</th>
                        <th>Capacity</th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
<script src="~/Scripts/EntityScript/Hall.js"></script>