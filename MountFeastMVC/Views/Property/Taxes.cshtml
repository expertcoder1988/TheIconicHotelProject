
@{
    ViewBag.Title = "Taxes";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-header with-border">
    <h3 class="callout callout-info" style="text-align: center; font-weight: bold; font-size: 20px">Taxes</h3>
</div>

<input type="hidden" id="AvoidReload" value="false" />
<input type="hidden" id="TaxId" value="0" />
<div class="box-body">
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-6">
                    <label id="lblProduct">
                        Please Select Property
                    </label>
                    <select ID="ddlProperty" class="form-control">
                    </select>
                </div>
                <div class="col-md-6">
                    <label id="lblProduct">
                        Please Select Room
                    </label>
                    <select ID="rooms" class="form-control">
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-6">
                    <label id="lblProduct">
                        Tax Name
                    </label>
                    <input type="text" class="form-control" id="TaxName" name="TaxName" maxlength="25" />
                </div>
                <div class="col-md-6">
                    <label id="percent">
                        Tax Should be detected as
                    </label>
                    <br/>
                    <input type="radio" id="prcent" name="DetectedAs" value="%" /> Percentage (%)
                    <input type="radio" id="amt" name="DetectedAs" value="Amount" /> Amount
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-6">
                    <label id="lblProduct">
                        <span id="AmtType">%</span>
                    </label>
                    <input type="number" class="form-control" id="Amount" name="Amount" />
                </div>
                <div class="col-md-6">
                    <br />
                    <input type="button" class="btn btn-primary" id="Save" value="Save" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="box-body">
   <div class="row">
            <div class="col-md-12 col-xs-12">
                <table class="table" id="Taxes">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Room</th>
                            <th>Tax Name</th>
                            <th>Detected As</th>
                            <th>Amount</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
</div>

<script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
<script src="~/Scripts/EntityScript/Tax.js"></script>