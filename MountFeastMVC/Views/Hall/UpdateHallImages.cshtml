
@{
    ViewBag.Title = "UpdateHallImages";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-header with-border">
    <h3 class="callout callout-info" style="text-align: center; font-weight: bold; font-size: 20px">Upload Images Of Hotel Halls</h3>
</div>


<h3 style="text-align: center; font-weight: bold; font-size: 16px; color: red">
    Uploading Image size Must Be Less then 1MB
</h3>
<br />
<h3 style="text-align: center; font-weight: bold; font-size: 12px; color: red">
    Uploaded mean image uploaded successfully and uploading mean image size is greater, resize image size and upload again
</h3>
<br />
<br />
<div class="box-body">
    <div class="row">
        <div class="col-md-8">
            <div class="form-group">
                <label id="lblHallCategory" runat="server">
                    Please Select Hall Category
                </label>
                <select ID="ddlHallCategory" class="fstdropdown-select" >
                </select>


            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="form-group">
                <label>
                    Refresh Selection
                </label>
                <Button ID="btnRefresh" class="btn btn-primary" Text="Refresh" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <input type="file" />
                @*<asp:AjaxFileUpload ID="AddHotelImages" runat="server" ThrobberID="myThrobber" MaximumNumberOfFiles="50"
                                    AllowedFileTypes="jpg,jpeg,gif,JPG,JPEG,GIF,PNG,png" OnUploadComplete="AddHotelImages_UploadComplete"
                                    OnClientUploadComplete="OnClientUploadComplete" OnClientUploadError="showUploadError" />*@
            </div>
        </div>
    </div>

    <div align="center">
        <Button ID="btnSaveImages" class="btn btn-primary" Text="Next" />
    </div>

    <div>

    </div>
</div>
<div class="box-body">
    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
                
            </div>
        </div>
    </div>
</div>


