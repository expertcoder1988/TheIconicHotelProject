<link rel="stylesheet" type="text/css" href="~/Content/Assets/css/PlusMinus.css">
<link href="https://code.jquery.com/ui/1.10.4/themes/ui-lightness/jquery-ui.css"
      rel="stylesheet">
<script src="https://code.jquery.com/jquery-1.10.2.js"></script>
<script src="https://code.jquery.com/ui/1.10.4/jquery-ui.js"></script>
<script>
    var $j = jQuery.noConflict();
    $j(document).ready(function () {
        var dateToday = new Date();
        $j("#CheckIn").datepicker({
            numberOfMonths: 1,
            minDate: dateToday,
            constrainInput: true,
            showButtonPanel: true,
            hideIfNoPrevNext: true,
            dateFormat: 'dd-mm-yy',
            onSelect: function (date) {
                var dt = $j("#CheckIn").val();
                var res = dt.split("-");
                dt = res[1] + "/" + res[0] + "/" + res[2];
                //alert(dt);
                var d1 = new Date(dt);
                //alert(d1);
                var d = new Date();
                d1.setDate(d1.getDate() + 1);
                // alert(d1);
                var m = d1.getMonth() + 1;
                // alert(m);
                var d2 = d1.getDate();
                var y = d1.getFullYear();
                if (d2 < 10) {
                    d2 = "0" + d2;
                }

                if (m < 10) {
                    m = "0" + m;
                }
                var z = [d2, m, y].join('-');
                $j("#CheckOut").datepicker('setDate', null);
                $j('#CheckOut').datepicker('option', { minDate: z });
            },
            onClose: function (dateText, inst) {
                //$("#start").removeClass('hasDatepicker').datepicker(),
                $j('#CheckOut').datepicker("show");
            }
        });
        $j("#CheckOut").datepicker({

            numberOfMonths: 1,
            constrainInput: true,
            //minDate: dateToday,
            showButtonPanel: false,
            dateFormat: 'dd-mm-yy',
            showOn: "focus",
            hideIfNoPrevNext: true,
            //defaultDate: +1
        });

        $j("#CheckInM").datepicker({
            numberOfMonths: 1,
            minDate: dateToday,
            constrainInput: true,
            showButtonPanel: true,
            hideIfNoPrevNext: true,
            dateFormat: 'dd-mm-yy',
            onSelect: function (date) {
                var dt = $j("#CheckInM").val();
                var res = dt.split("-");
                dt = res[1] + "/" + res[0] + "/" + res[2];
                //alert(dt);
                var d1 = new Date(dt);
                //alert(d1);
                var d = new Date();
                d1.setDate(d1.getDate() + 1);
                // alert(d1);
                var m = d1.getMonth() + 1;
                // alert(m);
                var d2 = d1.getDate();
                var y = d1.getFullYear();
                if (d2 < 10) {
                    d2 = "0" + d2;
                }

                if (m < 10) {
                    m = "0" + m;
                }
                var z = [d2, m, y].join('-');
                $j("#CheckOutM").datepicker('setDate', null);
                $j('#CheckOutM').datepicker('option', { minDate: z });
            },
            onClose: function (dateText, inst) {
                //$("#start").removeClass('hasDatepicker').datepicker(),
                $j('#CheckOutM').datepicker("show");
            }
        });
        $j("#CheckOutM").datepicker({

            numberOfMonths: 1,
            constrainInput: true,
            //minDate: dateToday,
            showButtonPanel: false,
            dateFormat: 'dd-mm-yy',
            showOn: "focus",
            hideIfNoPrevNext: true,
            //defaultDate: +1
        });

        $j("#CheckInMob").datepicker({
            numberOfMonths: 1,
            minDate: dateToday,
            constrainInput: true,
            showButtonPanel: true,
            hideIfNoPrevNext: true,
            dateFormat: 'dd-mm-yy',
            onSelect: function (date) {
                var dt = $j("#CheckInMob").val();
                var res = dt.split("-");
                dt = res[1] + "/" + res[0] + "/" + res[2];
                //alert(dt);
                var d1 = new Date(dt);
                //alert(d1);
                var d = new Date();
                d1.setDate(d1.getDate() + 1);
                // alert(d1);
                var m = d1.getMonth() + 1;
                // alert(m);
                var d2 = d1.getDate();
                var y = d1.getFullYear();
                if (d2 < 10) {
                    d2 = "0" + d2;
                }

                if (m < 10) {
                    m = "0" + m;
                }
                var z = [d2, m, y].join('-');
                $j("#CheckOutMob").datepicker('setDate', null);
                $j('#CheckOutMob').datepicker('option', { minDate: z });
            },
            onClose: function (dateText, inst) {
                //$("#start").removeClass('hasDatepicker').datepicker(),
                $j('#CheckOutMob').datepicker("show");
            }
        });
        $j("#CheckOutMob").datepicker({

            numberOfMonths: 1,
            constrainInput: true,
            //minDate: dateToday,
            showButtonPanel: false,
            dateFormat: 'dd-mm-yy',
            showOn: "focus",
            hideIfNoPrevNext: true,
            //defaultDate: +1
        });

        $('[data-quantity="plus"]').click(function (e) {
            // Stop acting like a button
            e.preventDefault();
            // Get the field name
            fieldName = $(this).attr('data-field');
            // Get its current value
            var currentVal = parseInt($('input[name=' + fieldName + ']').val());
            // If is not undefined
            if (!isNaN(currentVal)) {
                // Increment
                $('input[name=' + fieldName + ']').val(currentVal + 1);
            } else {
                // Otherwise put a 0 there
                $('input[name=' + fieldName + ']').val(0);
            }
        });
        // This button will decrement the value till 0
        $('[data-quantity="minus"]').click(function (e) {
            // Stop acting like a button
            e.preventDefault();
            // Get the field name
            fieldName = $(this).attr('data-field');
            // Get its current value
            var currentVal = parseInt($('input[name=' + fieldName + ']').val());
            // If it isn't undefined or its greater than 0
            if (!isNaN(currentVal) && currentVal > 0) {
                // Decrement one
                $('input[name=' + fieldName + ']').val(currentVal - 1);
            } else {
                // Otherwise put a 0 there
                $('input[name=' + fieldName + ']').val(0);
            }
        });

    });
</script>

