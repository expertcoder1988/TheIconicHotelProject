
@{
    ViewBag.Title = "Page Note Found!";
}

<div class="error-page">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-12">
                <div class="error404-content">
                    <div class="error404">404</div>
                </div>
            </div>
            <div class="col-lg-6 col-md-12">
                <div class="nobottomborder">
                    <h1>We're sorry, but the page you were looking for doesn't exist</h1>
                    <p>Return to the home page using the button below.</p>
                    <a class="btn-1 btn-outline-1" href="@Url.Action("Index","Home")">
                        <span>Return to Page</span> <i class="arrow"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

