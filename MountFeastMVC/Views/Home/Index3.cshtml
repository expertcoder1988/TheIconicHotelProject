<!-- Featured properties start -->
<div class="content-area featured-properties">
    <div class="container">
        <!-- Main title -->
        <div class="main-title">
            <h2>Available Rooms</h2>
        </div>
        <div class="row">
            @foreach (var item in results)
            {
                string[] features = null;

                <div class="col-lg-6 col-md-12 col-sm-12 wow fadeInLeft delay-04s">
                    <div class="row g-0 property fp2">
                        <div class="col-lg-5 col-md-5 col-sm-5 col-xs-12">
                            <!-- Property img -->
                            <div class="property-img">
                                <div class="property-tag button alt featured">Featured</div>
                                <div class="property-price">@item.TotalAmount</div>
                                @*<img src="~/uploads/@item.imgURL" alt="fp-list" class="img-responsive hp-2">*@
                                <img src="@Url.Action("Image", "Home", new { img = @item.imgURL })" alt="hotels in naran" class="img-responsive hp-2">

                                <div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7 col-md-7 col-sm-7 col-xs-12 property-content">
                            <!-- Info -->
                            <div class="info">
                                <!-- title -->
                                <h2 class="title">
                                    @*<a href="@Url.Action("RoomDetails", "SearchResult", new { Id = @item.RoomCateCode })">@item.RoomCategory</a>*@
                                    <a role="button" onclick='return check()'>@item.RoomCategory</a>
                                </h2>
                                <!-- Property address -->
                                <h3 class="property-address">
                                </h3>
                                <!-- Facilities List -->
                                <ul class="facilities-list fl-2 clearfix">
                                    @{
                                        if (item.Features != null)
                                        {
                                            features = item.Features.Split(',');
                                            for (int i = 0; i < 4; i++)
                                            {
                                                if (i < features.Length)
                                                {
                                                    if (features[i] != "")
                                                    {
                                                        <li style="font-size:10px">
                                                            <i class="fa fa-check"></i>
                                                            <span>@features[i].Replace('_', ' ')</span>
                                                        </li>
                                                    }
                                                }
                                            }
                                        }
                                    }

                                </ul>
                                <!-- Property footer -->
                            </div>
                            <!-- Property footer -->
                            <div class="property-footer">
                                <span class="left">
                                    <button onclick='return check()' class="btn btn-danger">Search Dates</button>
                                </span>
                                <span class="right">
                                    @*<i class="fa fa-calendar"></i>@item.NoOfRooms <span>    Rooms Left</span>*@
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

