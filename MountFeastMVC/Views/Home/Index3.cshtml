<script type="text/javascript">
    function check() {
        $('#myModal').modal('show');
    }

    function close() {
        $('#myModal').modal('hide');
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        if ($(window).width() > 700) {
            $("#MobileSearch").remove();
            $("#WindowSearch").show();
        }
        else {
            $("#MobileSearch").show();
            $("#WindowSearch").remove();
        }

        $('#datepicker').datepicker({
            uiLibrary: 'bootstrap4'
        });
    });
    function check() {
        $('#myModal').modal('show');
    }

    function close() {
        $('#myModal').modal('hide');
    }
    function ShowInputContainer() {
        $('#InputOverlay').show();
        $('#InputContainer').show();
    }
    function HideInputContainer() {
        $('#InputOverlay').hide();
        $('#InputContainer').hide();
    }
    function ShowDatepickerContainer() {
        $('#DatepickerOverlay').show();
        $('#DatepickerContainer').show();
        $('html, body').css({
            overflow: 'hidden',
            height: '100%'
        });
        $('#MobileDaterangePicker').click()

    }
    function HideDatepickerContainer() {
        $('#DatepickerOverlay').hide();
        $('#DatepickerContainer').hide();
        $('html, body').css({
            overflow: 'auto',
            height: 'auto'
        });
    }
</script>


