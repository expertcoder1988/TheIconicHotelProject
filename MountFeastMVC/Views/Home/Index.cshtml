        "../uploads/icon/Deluxe Quadruple Room.png",
        "../uploads/icon/Family Room with Terrace.png",
        "../uploads/icon/Presidential Suite with Terrace.png",
};

            int staticImageIndex = 0;
        }

        <div class="row">
            @foreach (var item in results)
            {
                string[] features = null;

                <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="property-3">
                        <img src="@staticImages[staticImageIndex]" alt="photo" class="img-fluid w-100" />
                        <div class="featured-tag2">Featured</div>
                        <div class="ling-section">
                            <h3>
                                <a href="properties-details.html">@item.RoomCategory</a>
                            </h3>
                            <ul class="facilities-list">
                                @{
                                    if (item.Features != null)
                                    {
                                        features = item.Features.Split(',');
                                        for (int i = 0; i < 4; i++)
                                        {
                                            if (i < features.Length)
                                            {
                                                if (features[i] != "")
                                                {
                                                    <li style="font-size:10px">
                                                        <i class="fa fa-check"></i>
                                                        <span>@features[i].Replace('_', ' ')</span>
                                                    </li>
                                                }
                                            }
                                        }
                                    }
                                }
                                <li>4 Beds</li>
                                <li>4 Baths</li>
                                <li>920 SQ FT</li>
                                <li>1 Garage</li>
                            </ul>
                            <a onclick='return check()' class="read-more-btn">Search Dates</a>
                        </div>
                    </div>
                </div>

            
                staticImageIndex++;
                if (staticImageIndex >= staticImages.Count)
                {
                    staticImageIndex = 0;
                }
            }
        </div>
    </div>
