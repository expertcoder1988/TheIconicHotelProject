@{
    ViewBag.Title = "Calendar";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<style>

    th {
        font: 15px 'Segoe UI';
        background-color: silver;
        font-weight: bold;
        padding: 5px 10px;
    }

    td, p, input, h3 {
        font: 12px 'Segoe UI';
    }

    td {
        border: solid 1px #ddd;
        text-align: center;
        padding: 5px 10px;
    }

    table, th {
        border: solid 1px #ddd;
        border-collapse: collapse;
        text-align: center;
    }

    div.ex3 {
        background-color: whitesmoke;
        width: 100%;
        height: 100%;
        overflow: auto;
    }

    #right {
        position: absolute;
        right: 0px;
        width: 300px;
        border: 3px solid #73AD21;
        padding: 10px;
    }
</style>

<div class="box-body">
    <h5 class="callout callout-info">Calendar</h5>
    <input type="hidden" id="AvoidReload" value="false" />
    <div class="container">
        <div class="row">
            <div class="form-group">
                <div >
                    <label id="lblProduct">
                        Please Select Property
                    </label>
                    <select ID="Properties" class="form-control" style="width:250px">
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            Legends: <span style="color:silver">Silver=Open</span>,<span style="color:red">Red=Booked</span>,<span style="color:blue">Blue=Checkin</span>,<span style="color:green">Green=Paid</span>
        </div>
  
        <div class="row">
            <div id="showData" class="ex3">
            </div>
        </div>
    </div>
</div>


    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"><span id="eventTitle"></span></h4>
                </div>
                <div class="modal-body">
                    <p id="pDetails"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>


    <script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
    <script src="~/Scripts/EntityScript/Calendar.js"></script>

