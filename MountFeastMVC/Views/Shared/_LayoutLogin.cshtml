<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - The Iconic Hotel Naran</title>
    <!-- External CSS libraries -->

    <link href="~/Content/LogInLayout/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/LogInLayout/css/style.css" rel="stylesheet" />


    <!-- Favicon icon -->
    <link rel="shortcut icon" href="~/Content/Assets/img/fav.png" type="image/x-icon">

    <!-- Google fonts -->
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Open+Sans:400,300,600,700,800%7CPlayfair+Display:400,700%7CRoboto:100,300,400,400i,500,700" />

    <link rel="stylesheet" type="text/css" href="~/Content/TemplateFiles/css/ie10-viewport-bug-workaround.css" />
