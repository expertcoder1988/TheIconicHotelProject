            <div class="container">
                <p>&copy; @DateTime.Now.Year</p>
            </div>
        </footer>*@
    <script src="~/Content/LogInLayout/js/jquery.min.js"></script>
    <script src="~/Content/LogInLayout/js/popper.js"></script>
    <script src="~/Content/LogInLayout/js/bootstrap.min.js"></script>
    <script src="~/Content/LogInLayout/js/main.js"></script>

