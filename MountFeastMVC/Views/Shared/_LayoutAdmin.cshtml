<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewBag.Title - The Iconic Hotel</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <link rel="shortcut icon" href="~/Content/Assets/img/favicon.jpg" type="image/x-icon">
    <link rel="stylesheet" href="~/Content/Admin/Bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.5.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/ionicons/2.0.1/css/ionicons.min.css" />
    <link href="~/Content/Admin/dist/css/AdminLTE.min.css" rel="stylesheet" />
    <link href="~/Content/Admin/dist/css/skins/_all-skins.min.css" rel="stylesheet" />
    <link href="~/Content/Admin/Styles/style-responsive.css" rel="stylesheet" />
    <link href="~/Content/Admin/Styles/bootstrap.min.css" rel="stylesheet" />
    <link href="//cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.4.0/fullcalendar.min.css" rel="stylesheet" />
    <link href="//cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.4.0/fullcalendar.print.css" rel="stylesheet" media="print" />
    @*<link rel="stylesheet" href="~/Content/Admin/plugins/iCheck/flat/blue.css" />
        <link rel="stylesheet" href="~/Content/Admin/plugins/morris/morris.css" />*@

    <!-- Favicon icon -->
    <link rel="shortcut icon" href="~/Content/Assets/img/fav.png" type="image/x-icon">

    <link href='~/Scripts/lib/main.css' rel='stylesheet' />

    <link href="~/Content/Admin/Styles/fstdropdown.css" rel="stylesheet" />
    <link href="~/Content/Admin/gridImg/style.css" rel="stylesheet" />
    <link href="~/Content/summernote.css" rel="stylesheet" />

</head>
<body class="hold-transition skin-blue sidebar-mini">
    <form id="form1">
        <asp:ScriptManager ID="ScriptManagerID">
        </asp:ScriptManager>
        <div class="wrapper">

            <header class="main-header">
                <!-- Logo -->
                <a href="Default.aspx" class="logo">
                    <!-- mini logo for sidebar mini 50x50 pixels -->
                    <span class="logo-mini">TIH</span>
                    <!-- logo for regular state and mobile devices -->
                    <span class="logo-lg"><b>The Iconic Hotel</b></span>
                </a>
                <!-- Header Navbar: style can be found in header.less -->
                <nav class="navbar navbar-static-top">
                    <!-- Sidebar toggle button-->
                    <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
                        <span class="sr-only">Toggle navigation</span>
                    </a>

                    <div class="navbar-custom-menu">
                        <ul class="nav navbar-nav">

                            <!-- User Account: style can be found in dropdown.less -->
                            <li class="dropdown user user-menu">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                    <img src="~/Content/Assets/img/fav.png" class="user-image" alt="User Image">
                                    <span class="hidden-xs">
                                        <asp:Label ID="lblUser" Text=""></asp:Label>
                                    </span>
                                </a>
                                <ul class="dropdown-menu">
                                    <!-- User image -->
                                    <li class="user-header">
                                        <img src="~/Content/Assets/img/fav.png" class="img-circle" alt="User Image">

                                        <p>
                                            <asp:Label ID="lblUsers" Text=""></asp:Label>
                                        </p>
                                    </li>
                                    <!-- Menu Footer-->
                                    <li class="user-footer">
                                        <div class="pull-left">
                                            <a href="#" class="btn btn-primary">Profile</a>
                                        </div>
                                        <div class="pull-right">
                                            <a href="@Url.Action("Logout", "Login")" style="color: white;"
                                               class="btn btn-primary">Sign Out</a>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>
            <!-- Left side column. contains the logo and sidebar -->
            <aside class="main-sidebar">
                <!-- sidebar: style can be found in sidebar.less -->
                <section class="sidebar">
                    <!-- Sidebar user panel -->
                    <div class="user-panel">
                    </div>
                    @{
                        if (Session["Access"] == null)
                        {
                            Session["Access"] = "0,";
                        }

                        string Access = Session["Access"].ToString();
                        string[] arrAccess = Access.Split(',');
                        //HotelWebSite.Models.HotelDBEntities HDE = new HotelWebSite.Models.HotelDBEntities();
                    }
                    <ul class="sidebar-menu">
                        @{
                            var _access = (from i in arrAccess where i == "1" select new { acc = i }).FirstOrDefault();

                            if (_access != null && _access.acc.ToString() == "1")
                            {
                                <li class="active treeview">
                                    <a href="@Url.Action("Index", "Dashboard")">
                                        <i class="fa fa-dashboard"></i><span>Dashboard</span>
                                    </a>
                                </li>
                            }
                        }

                        @{
                            _access = (from i in arrAccess where i == "2" select new { acc = i }).FirstOrDefault();

                            if (_access != null && _access.acc.ToString() == "2")
                            {
                                <li class="treeview">
                                    <a href="#">
                                        <i class="fa fa-building"></i>
                                        <span>PROPERTY</span>
                                        <span class="pull-right-container">
                                            <i class="fa fa-angle-left pull-right"></i>
                                        </span>
                                    </a>
                                    <ul class="treeview-menu">
                                        <li>
                                            <a href="@Url.Action("Index", "Property")"><i class="fa fa-home"></i> Property</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("NewRoomCategory", "Property")"><i class="fa fa-th-large"></i> Room Categories</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Rooms", "Property")"><i class="fa fa-bed"></i> Rooms</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("RoomImages", "Property")"><i class="fa fa-image"></i> Room Images</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Index", "Policy")"><i class="fa fa-file-text-o"></i> Policies</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("RatePlan", "Policy")"><i class="fa fa-tags"></i> Rate Plans</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("RateSlab", "Property")"><i class="fa fa-money"></i> Rate Slab</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("BlockRoom", "Property")"><i class="fa fa-ban"></i> Block Room</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Taxes", "Property")"><i class="fa fa-percent"></i> Taxes</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Halls", "Property")"><i class="fa fa-university"></i> Halls</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }

                        @{
                            _access = (from i in arrAccess where i == "3" select new { acc = i }).FirstOrDefault();

                            if (_access != null && _access.acc.ToString() == "3")
                            {
                                <li class="treeview">
                                    <a href="@Url.Action("Index", "Booking")">
                                        <i class="fa fa-calendar"></i>
                                        <span>BOOKING DETAILS</span>
                                        <span class="pull-right-container">
                                            <i class="fa fa-angle-left pull-right"></i>
                                        </span>
                                    </a>
                                    <ul class="treeview-menu">
                                        <li>
                                            <a href="@Url.Action("Index", "Booking")"><i class="fa fa-list"></i> Booking List</a>
                                        </li>
                                        <li>
                                            <a href="@Url.Action("Booking", "Booking")"><i class="fa fa-plus-circle"></i> New Booking</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }

                        @{
                            _access = (from i in arrAccess where i == "4" select new { acc = i }).FirstOrDefault();

                            if (_access != null && _access.acc.ToString() == "4")
                            {
                                <li class="treeview">
                                    <a href="@Url.Action("Index", "Calander")">
                                        <i class="fa fa-calendar-check-o"></i>
                                        <span>CALANDER</span>
                                    </a>
                                </li>
                            }
                        }

                        @* Voucher Management *@
                        @{
                            _access = (from i in arrAccess where i == "8" select new { acc = i }).FirstOrDefault();
                            if (_access != null)
                            {
                                <li class="treeview">
                                    <a href="#">
                                        <i class="fa fa-gift"></i> <span>Voucher Management</span>
                                        <span class="pull-right-container">
                                            <i class="fa fa-angle-left pull-right"></i>
                                        </span>
                                    </a>
                                    <ul class="treeview-menu">
                                        <li><a href="@Url.Action("Create", "Voucher")"><i class="fa fa-plus-circle"></i> Add Voucher</a></li>
                                        <li><a href="@Url.Action("Index", "Voucher")"><i class="fa fa-eye"></i> View Vouchers</a></li>
                                    </ul>
                                </li>
                            }
                        }

                        @{
                            _access = (from i in arrAccess where i == "8" select new { acc = i }).FirstOrDefault();

                            if (_access != null && _access.acc.ToString() == "8")
                            {
                                <li class="treeview">
                                    <a href="@Url.Action("Index", "ReservationReport")">
                                        <i class="fa fa-bar-chart"></i>
                                        <span>RESERVATION REPORT</span>
                                    </a>
                                </li>
                            }
                        }

                        @{
                            _access = (from i in arrAccess where i == "7" select new { acc = i }).FirstOrDefault();

                            if (_access != null && _access.acc.ToString() == "7")
                            {
                                <li class="treeview">
                                    <a href="@Url.Action("Index", "User")">
                                        <i class="fa fa-users"></i>
                                        <span>USER LIST</span>
                                    </a>
                                </li>
                            }
                        }

                        @{
                            _access = (from i in arrAccess where i == "8" select new { acc = i }).FirstOrDefault();

                            if (_access != null && _access.acc.ToString() == "8")
                            {
                                <li class="treeview">
                                    <a href="@Url.Action("Index", "Post")">
                                        <i class="fa fa-pencil-square-o"></i>
                                        <span>BLOG</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                </section>
                <!-- /.sidebar -->
            </aside>

            <!-- Content Wrapper. Contains page content -->
            <div class="content-wrapper">
                @RenderBody()
            </div>
            <footer class="main-footer">
                <div class="pull-right hidden-xs">
                    <b>Copy Right</b> © 2021
                </div>
                <strong><i class="fa fa-love"></i><a href="https://www.growbiztech.com">Developed by GrowBiz Tech</a></strong>
            </footer>
        </div>
    </form>
    <script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
    <script src="https://code.jquery.com/ui/1.11.4/jquery-ui.min.js"></script>
    @*<script type="text/javascript">jQuery.noConflict();</script>*@
    <script src="~/Content/Admin/bootstrap/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.11.2/moment.min.js"></script>
    <script src="~/Content/Admin/plugins/datepicker/bootstrap-datepicker.js"></script>
    <script src="~/Content/Admin/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
    <script src="~/Content/Admin/plugins/slimScroll/jquery.slimscroll.min.js"></script>
    <script src="~/Content/Admin/plugins/fastclick/fastclick.js"></script>
    <script src="~/Content/Admin/dist/js/app.min.js"></script>
    <script src="~/Content/Admin/dist/js/demo.js"></script>
    @*<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.18.1/moment.min.js"></script>
        <script src="//cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.4.0/fullcalendar.min.js"></script>*@
    <script src="../Scripts/EntityScript/fullcalendar.min.js" type="text/javascript"></script>
    <script src="../Scripts/EntityScript/scheduler.min.js" type="text/javascript"></script>
    <script src="../Scripts/EntityScript/theme-chooser.js" type="text/javascript"></script>
    <script src="~/Scripts/summernote/summernote.min.js"></script>

    <script src='~/Scripts/lib/main.js'></script>

</body>
</html>
