@{
    ViewBag.Title = "MakeFlightBooking";
    // Assuming TempData contains a dictionary
    var paymentData = (Dictionary<string, string>)TempData["FormData"];
}

<h2>Redirect to Payment Gateway</h2>

<form id="FormPG" name="FormPG" action="https://ipg1.apps.net.pk/Ecommerce/api/Transaction/PostTransaction" method="POST">
    @foreach (var keyValuePair in paymentData)
    {
        <input type="hidden" id="@keyValuePair.Key" name="@keyValuePair.Key" value="@keyValuePair.Value" /><br />
    }
</form>
<script language='javascript'>
    var vPostForm = document.getElementById("FormPG");
    vPostForm.submit();
</script>
